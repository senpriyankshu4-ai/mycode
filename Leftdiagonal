import java.util.Scanner;
class LeftDiagonal
{
    public static void main (String args[]){

        Scanner sc=new Scanner(System.in);
        int arr[][]=new int[3][3];
        System.out.println("Enter the elements of the matrix");
        for(int i=0;i<3;i++)
        {
            for(int j=0;j<3;j++)
            {
                arr[i][j]=sc.nextInt();
            }
        }
        
        System.out.println("The sum of the left diagonal are:");
        int sum=0;
        for(int i=0;i<3;i++)
        {
            sum+=arr[i][i];
        }
        System.out.println(sum);
    }
}
